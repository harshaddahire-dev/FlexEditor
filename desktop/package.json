{
  "name": "cutroom-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Cutroom desktop app: builds the installer. The app itself lives in ./app (generated by build.mjs).",
  "author": "Cutroom",
  "license": "MIT",
  "devDependencies": {
    "electron": "42.11.16",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.cutroom.editor",
    "productName": "Cutroom",
    "directories": {
      "app": "app",
      "output": "../release",
      "buildResources": "build"
    },
    "asar": false,
    "npmRebuild": true,
    "artifactName": "Cutroom-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "**/*",
        "!node_modules/ffprobe-static/bin/{darwin,linux}/**",
        "!node_modules/ffprobe-static/bin/win32/ia32/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Cutroom"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "files": [
        "**/*",
        "!node_modules/ffprobe-static/bin/{win32,linux}/**"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "files": [
        "**/*",
        "!node_modules/ffprobe-static/bin/{win32,darwin}/**"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "harshaddahire-dev",
        "repo": "FlexEditor",
        "releaseType": "release"
      }
    ]
  }
}
