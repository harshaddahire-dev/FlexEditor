{
  "name": "cutroom",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, browser-based non-linear video editor where AI agents perform the editing.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cutroom/server --filter @cutroom/web dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @cutroom/server start",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "gen:sync-asset": "pnpm --filter @cutroom/server exec tsx scripts/gen-sync-asset.ts",
    "test:e2e": "playwright test -c e2e --grep-invert @shots",
    "test:shots": "playwright test -c e2e --grep @shots",
    "eval": "pnpm --filter @cutroom/agents exec vitest run test/evals.test.ts",
    "eval:live": "pnpm --filter @cutroom/server eval:live"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.6.3"
  }
}
